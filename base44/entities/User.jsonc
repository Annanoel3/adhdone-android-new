{
  "type": "object",
  "properties": {
    "signed_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user first signed up"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user was last active in the app"
    },
    "adhd_theme": {
      "type": "string",
      "description": "User's chosen base theme (minimalist, dark, colorful, spicybrains)"
    },
    "special_mode": {
      "type": "string",
      "description": "Special seasonal mode (normal, christmas, halloween, etc.)"
    },
    "seasonal_unlocked": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has unlocked seasonal themes via the easter egg"
    },
    "last_energy_checkin_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last energy check-in (YYYY-MM-DD) \u2014 prevents showing the modal more than once per day"
    },
    "timezone": {
      "type": "string",
      "description": "User's IANA timezone (set once on first login) for timezone-aware quiet hours"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether quiet hours are active for the user"
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "Quiet hours start in local HH:MM"
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "Quiet hours end in local HH:MM"
    },
    "focus_mode_task_id": {
      "type": "string",
      "description": "ID of the recurring task the user is currently focusing on (Focus Mode). Null/empty = not in Focus Mode."
    },
    "focus_mode_entered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user entered Focus Mode"
    }
  },
  "name": "User"
}