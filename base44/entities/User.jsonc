{
  "type": "object",
  "properties": {
    "preferred_name": {
      "type": "string",
      "description": "What the user asked to be called, in their own words, collected in the first-run chat. Used for greetings and in notification copy \u2014 the account's full_name is often a formal legal name (or a Google account name) that nobody actually calls them."
    },
    "about_me": {
      "type": "string",
      "description": "One or two sentences the user wrote about their own life in the first-run chat (e.g. 'I play violin at weddings', 'I'm a nurse on night shifts', 'two kids under 5'). Handed VERBATIM to the AI that classifies imported calendar items, parses tasks, plans reminders and writes nudges \u2014 a single title like 'Karly's Wedding' is unrankable without knowing the wedding is this person's job. Deliberately free text: a profession dropdown misses side work, caregiving and the hobbies that carry real obligation."
    },
    "signed_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user first signed up"
    },
    "last_active_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user was last active in the app"
    },
    "adhd_theme": {
      "type": "string",
      "description": "User's chosen base theme (minimalist, dark, colorful, spicybrains)"
    },
    "special_mode": {
      "type": "string",
      "description": "Special seasonal mode (normal, christmas, halloween, etc.)"
    },
    "seasonal_unlocked": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has unlocked seasonal themes via the easter egg"
    },
    "chaos_mode": {
      "type": "boolean",
      "default": false,
      "description": "The hidden 'chaos mode' ugly skin (found by tapping the version number in Settings seven times). Normally chaos mode lives only in sessionStorage so closing the app always escapes it \u2014 this flag exists so it can be switched ON for a specific account to look at. Tapping the version seven times clears it again, so nobody can be trapped in it."
    },
    "last_energy_checkin_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last energy check-in (YYYY-MM-DD) \u2014 prevents showing the modal more than once per day"
    },
    "timezone": {
      "type": "string",
      "description": "User's IANA timezone (set once on first login) for timezone-aware quiet hours"
    },
    "home_lat": {
      "type": "number",
      "description": "Latitude of the CENTER of the ~5-mile home circle the user placed on the map. This exact point is the origin for every drive-time / 'leave now' / commute calculation \u2014 the circle's radius is visual reassurance only and is never used to fuzz the math. Never used for tracking."
    },
    "home_lng": {
      "type": "number",
      "description": "Longitude of the center of the user's home circle. See home_lat."
    },
    "home_zip_prompt_seen_v2": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has already been shown (and dismissed or answered) the one-time home base ask. Stored on the profile so a new device doesn't re-ask."
    },
    "work_remote": {
      "type": "boolean",
      "default": false,
      "description": "True when the user works from home. There is no drive, so commute watch skips them entirely (no 'leave now' or traffic alerts) and no work address is asked for \u2014 but their work hours still count, so the 'don't notify me at work' quiet window works exactly the same."
    },
    "onboarding_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "First-run steps this ACCOUNT has already completed (welcome note, per-page tours). These flags used to live only in localStorage, so signing in again in a fresh session or on another device replayed the whole welcome + tour sequence. Kept on the profile so onboarding follows the person, not the device."
    },
    "pending_feedback_prompt": {
      "type": "object",
      "description": "Set by an admin when something this person captured was really a request for the app itself (a feature they want) and it wrongly became a task. Holds { text, task_id, queued_at } while waiting. The app shows a one-time popup with their own words, which they can edit, offering to send it to Anna through sendSupportRequest. Once they answer, the app overwrites this with { answered_at, answer } \u2014 never null, which the schema would reject \u2014 so the popup never shows again. While it is waiting, the ways-to-add popup holds off."
    },
    "alarm_mode": {
      "type": "string",
      "enum": [
        "notification",
        "alarm"
      ],
      "default": "notification",
      "description": "The user's DEFAULT alert style for tasks that have no alert_style of their own: 'notification' (everyone's default) = the usual push reminders only; 'alarm' = each of a task's existing reminders also rings as a real full-screen alarm on the installed Android app. It changes HOW reminders arrive, never WHEN. Android-only and native: the alarm itself lives in android/, which you must not edit, and it reads the task's existing reminder times. There is no web or server version of this and none should be built \u2014 a push notification is not an alarm."
    },
    "alarm_sound_url": {
      "type": "string",
      "description": "URL of the sound the phone rings alarms with: a preset from the app's sound bucket or a file the user uploaded through UploadFile. Empty = the phone's default alarm tone. The Android app downloads it once and rings from the local copy."
    },
    "alarm_sound_name": {
      "type": "string",
      "description": "Display name for alarm_sound_url (the preset's name or the uploaded file's name)."
    },
    "alarm_trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user pressed 'Try it out' on the one-time full-screen reminders introduction (alarm_mode was switched to 'alarm' at that moment). Once the phone reports a full-screen reminder rang after this time, the app asks ONCE on the next open whether to keep tasks that way (onboarding flag onboarding_fullscreen_keep_done). Empty = never tried from that popup."
    },
    "device_calendar_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ids of the calendars on the user's PHONE (Samsung Calendar, Outlook, any account Android's calendar app shows) that they chose to sync. Read by the Android app's native CalendarBridge plugin; the app sends those calendars' events to syncGoogleCalendar with source: 'device', which imports them through the same pipeline as Google. Empty = no phone calendars synced. Ids are only meaningful on that phone."
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether quiet hours are active. Defaults to ON: a reminder is worthless at 3 AM and actively harmful to trust in the app, so overnight silence is opt-OUT, not opt-in. Users who genuinely want middle-of-the-night pushes can turn it off in Settings."
    },
    "quiet_hours_start": {
      "type": "string",
      "default": "22:00",
      "description": "Quiet hours start in local HH:MM. Defaults to 22:00 so a user who never opens Settings still gets overnight silence."
    },
    "quiet_hours_end": {
      "type": "string",
      "default": "07:00",
      "description": "Quiet hours end in local HH:MM. Defaults to 07:00; anything that would have fired overnight is delivered at this time instead."
    },
    "google_refresh_token": {
      "type": "string",
      "description": "Long-lived Google OAuth refresh token for this user's own Google Calendar, obtained by the app's OWN OAuth flow (googleCalendarConnect \u2192 googleCalendarCallback). The platform's app-user connector completed Google consent but persisted no connection, so every sync returned 400 not_connected; the app now stores the grant itself and this field is the single source of truth for 'is Calendar connected'. Server-side only \u2014 never sent to the client."
    },
    "google_account_email": {
      "type": "string",
      "description": "The Google account the calendar grant actually belongs to, read from Google's userinfo at connect time. Shown on the Calendar page: it is frequently NOT the app login email (people link a personal calendar to a work login), and guessing wrong made the page claim the wrong account was syncing."
    },
    "google_connected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Google Calendar grant was last (re)established. Used to tell 'never connected' apart from 'connected but the grant was revoked at Google'."
    },
    "google_oauth_state": {
      "type": "string",
      "description": "Single-use random state for an in-flight Google consent. Google hits the callback with NO app session, so this is the only thing tying that redirect back to a user. Cleared the moment it is used, so a captured callback URL cannot be replayed."
    },
    "google_oauth_state_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the in-flight consent was started. The callback rejects a state older than 15 minutes, so an abandoned attempt can't be completed by someone else later."
    },
    "calendar_sync_in_progress_since": {
      "type": "string",
      "format": "date-time",
      "description": "Heartbeat timestamp for the per-account Google Calendar sync lock. A live sync refreshes it as it works, so a long first import keeps the lock while a crashed run's lock goes stale and the next trigger can take over. MUST exist here: syncGoogleCalendar writes it before every sync, and while it was missing from this schema the write failed validation and every single sync died with a 500 right after finding the user's Google token."
    },
    "calendar_sync_run_id": {
      "type": "string",
      "description": "Random id of the sync run that currently owns the calendar sync lock. Two triggers that both saw no lock both write, then the one whose id survived owns the run and the other stands down; release only clears the lock when the id still matches."
    },
    "focus_mode_task_id": {
      "type": "string",
      "description": "ID of the recurring task the user is currently focusing on (Focus Mode). Null/empty = not in Focus Mode."
    },
    "focus_mode_entered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user entered Focus Mode"
    },
    "onesignal_player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "OneSignal player IDs registered for this user's devices. Used for push notification targeting."
    },
    "last_smart_nudge_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last smart nudge sent to this user. Used by the app to open on the most recently nudged task."
    },
    "last_smart_nudge_task_id": {
      "type": "string",
      "description": "ID of the task the last smart nudge was about. The app opens on this task when the user opens the app after receiving a nudge."
    },
    "smart_nudge_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "ID of the task to nudge about"
          },
          "send_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this nudge should fire"
          },
          "title": {
            "type": "string",
            "description": "LLM-generated notification title"
          },
          "body": {
            "type": "string",
            "description": "LLM-generated notification body"
          },
          "type": {
            "type": "string",
            "enum": [
              "initial",
              "check_in",
              "multiple_urgent"
            ],
            "description": "Type of nudge: initial = first time surfacing a task, check_in = follow-up on a previously nudged task, multiple_urgent = multiple urgent tasks, pick one"
          },
          "sent": {
            "type": "boolean",
            "default": false,
            "description": "Whether this nudge has been sent"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this nudge was sent"
          }
        }
      },
      "default": [],
      "description": "LLM-generated daily schedule of 3-5 smart nudges. Regenerated once per day or when a task is marked urgent (dirty flag)."
    },
    "smart_nudge_schedule_date": {
      "type": "string",
      "format": "date",
      "description": "Date (YYYY-MM-DD) the current schedule was generated for. When this doesn't match today, a new schedule is generated."
    },
    "smart_nudge_schedule_dirty": {
      "type": "boolean",
      "default": false,
      "description": "Set to true when a task is marked urgent (or other significant change) to trigger schedule regeneration on the next cron run."
    },
    "calendar_use_emoji": {
      "type": "boolean",
      "description": "Calendar display mode: true = emoji icons, false = text titles. Saved from the Emoji/Text toggle on the Calendar page so the choice follows the user across devices."
    }
  },
  "name": "User"
}