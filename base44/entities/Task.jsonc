{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "capture_id": {
      "type": "string",
      "description": "Idempotency key for captures that arrive from OUTSIDE the app (the native share sheet / quick capture). Native generates one UUID per capture attempt and resends the same one on retry, so a lost response can't double-create: the capture endpoint looks for an existing task with this id and returns it instead of creating a second one. Empty for tasks created inside the app."
    },
    "google_event_id": {
      "type": "string",
      "description": "Idempotency key for tasks imported from Google Calendar: the Google event id. Together with notification_recipient_email it identifies one imported event for one user. The sync checks for an existing task with this key BEFORE creating, so an interrupted or overlapping sync can never produce a second copy of the same event. Empty for tasks created inside the app."
    },
    "reminder_scheduling_since": {
      "type": "string",
      "format": "date-time",
      "description": "Set at the moment a task is created whose reminders are about to be booked (client fire-and-forget or server-side). Cleared once the notification ids are written. The refill cron skips any task with a fresh value here so it can't book a second batch of pushes while the creator is still booking the first. Timestamp, not a boolean, so a crash that never clears it self-expires."
    },
    "location": {
      "type": "string",
      "description": "Optional physical place this task happens at (address, business name + city, or zip). ONLY set when the user explicitly gave a location \u2014 never inferred from the task wording. The smart-nudge system uses this to suggest combining two errands into one trip, so an inferred/guessed value would produce a bad suggestion."
    },
    "business_name": {
      "type": "string",
      "description": "A business, office, clinic or store the task involves in any way (to call, visit, email or order from), as the user named it. Set by the parser. Unlike location, it says nothing about going there."
    },
    "business_hours": {
      "type": "object",
      "description": "Opening hours of business_name, looked up once through Google Places near the user's home (name, address, place_id, periods, weekday_text, utc_offset, checked_at; not_found when Places had nothing). The Smart Reminders planner reads it so it never nudges a call to a closed office. Looked up again after 30 days."
    },
    "task_family": {
      "type": "string",
      "description": "The one repeated thing this task is, in 1-3 lowercase words, the same however it's worded or whose it is ('Put away my laundry' and 'Put away Antonio's laundry' are both 'laundry'). Set by the server with the model (cronSmartTaskNudge for open tasks, logTaskCompletion on completion) and copied to a repeating task's next occurrence. Time estimates and completion habits are kept per family."
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task was finished, by the server's clock (logTaskCompletion). Completion habits are read from this. completed_at was written by the phone in two formats until Oct 16 2026 (some screens stamped local clock time as UTC); every screen now writes true UTC."
    },
    "typical_minutes": {
      "type": "number",
      "description": "How long this kind of task usually takes this person: the middle (median) timed session (Sprints / Launchpad) on its task_family. Stamped by cronSmartTaskNudge; shown on the task card and read by the Smart Reminders planner."
    },
    "habit_suggestion": {
      "type": "object",
      "description": "An offer to move this task's reminder to when the person usually does this kind of task: { time 'HH:MM', why (one sentence shown to them), made_at }, made by logTaskCompletion with the model. The person answers on the task (TaskDetailsModal): answer 'yes' | 'no', answered_at. A yes never sets a time on the task: the Smart Reminders planner reads it as their preferred time for that family. Offered only on tasks the planner reminds them about (no time of their own, no repeating reminder)."
    },
    "snoozed_until": {
      "type": "string",
      "format": "date-time",
      "description": "When a snooze on the phone's alarm (or a reminder's Snooze button) brings this task back. The phone reports it the moment the snooze is tapped (build 39+, cancelTaskNotifications mode alarm_choice). Smart Reminders sees it and sends no nudge of its own about the task while the snooze is pending."
    },
    "last_alarm_choice": {
      "type": "object",
      "description": "The last choice made on this task's alarm or reminder notification: { choice 'snooze' | 'dismiss' | 'ignored' | 'later' | 'closed', at, minutes (a snooze's length), until (when the snooze or Later break ends), how ('home' | 'back' | 'closed': the alarm screen was left that way while it rang \u2014 on 'closed', and on a 'snooze' that Home or Back made for a time set inside quiet hours) }. Reported by the phone the moment it's made (build 39+); shown to Smart Reminders."
    },
    "alarm_report_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The last 20 alarm-choice report ids the phone sent for this task, so a retried report is never counted twice."
    },
    "original_input": {
      "type": "string",
      "description": "The user's VERBATIM input (typed or transcribed) that created this task, stored exactly as spoken/typed with no cleanup. Used to audit AI parsing errors \u2014 e.g. when a date, subject, or misheard word ends up wrong, the raw phrasing can be compared against what the parser produced."
    },
    "description": {
      "type": "string",
      "description": "Detailed task description"
    },
    "reminder_interval": {
      "type": "string",
      "enum": [
        "10min",
        "20min",
        "30min",
        "1hour",
        "2hours",
        "4hours",
        "daily",
        "every_other_day",
        "once"
      ],
      "description": "How often to remind"
    },
    "reminder_count": {
      "type": "number",
      "description": "How many times to send reminders (0 = until complete)",
      "default": 0
    },
    "next_reminder": {
      "type": "string",
      "format": "date-time",
      "description": "When to send next reminder"
    },
    "due_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional deadline for interval-reminder tasks. Interval reminders continue until this date, then switch to overdue reminders until the task is completed."
    },
    "due_date_pushes": {
      "type": "number",
      "default": 0,
      "description": "How many times the user has pushed this task's due date later. Tracked so Insights and the smart-nudge LLM can spot chronically postponed tasks and suggest breaking them down or rethinking them."
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional date the user began actively working on this task. When set alongside due_date, the task acts like a multi-day event: it shows on each day from start_date through due_date and appears in Today's Tasks the entire span, even if the due date is far out. A parsed 'by' deadline ('sometime this week', 'by Friday') is saved with start_date = when it was said, so it sits under Today every day until the deadline (Anna, Oct 14 2026; taskSchedule.deadlineWindowStart / captureToTasks.buildTaskRecord)."
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "For multi-day events, the last day of the span. When set, the event shows on each day from next_reminder through end_date."
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "The actual date/time an event takes place. Stored separately from next_reminder (the reminder time) so the event time stays visible on the task card even after the user manually edits the reminder time. Only set for events with a specific time."
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "When a timed task or event FINISHES, turning a single moment into a block: the card then reads '10:00 AM \u2013 6:00 PM' instead of just a start. Distinct from end_date, which is the last DAY of a multi-day span. Only set when the user gave an end time \u2014 a task with no end_time keeps its single-time label rather than showing half a range. Ignored for day_only_task items, which have no clock time at all."
    },
    "day_only_task": {
      "type": "boolean",
      "default": false,
      "description": "True when the task is tied to a specific day with NO specific time (e.g. 'remind me to do X on Friday'). Gets a single night-before heads-up, then smart hourly nudges from cronSmartTaskNudge (which picks ONE task to surface at a time with an LLM-written message) instead of per-task hourly notifications that flood the notification tray."
    },
    "deadline_style": {
      "type": "string",
      "enum": [
        "on",
        "by"
      ],
      "default": "on",
      "description": "For day-only tasks, HOW the date was expressed \u2014 these behave very differently. 'on' = the task must happen ON that specific day ('remind me to do X on Friday'): no reminders in the days leading up, just a night-before heads-up plus day-of nudges. 'by' = the date is a DEADLINE the task must be finished by ('get X done by Friday'): the task can be worked on any time before then, so reminders start in advance \u2014 days or even a couple of weeks out depending on how much work the task actually takes \u2014 and continue up through the due day."
    },
    "last_scheduled_until": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last (furthest-out) scheduled reminder \u2014 used by cron to know when to refill"
    },
    "reminder_retry_after": {
      "type": "string",
      "format": "date-time",
      "description": "Set by cronRefillReminders when OneSignal refuses to book this task's reminders (most often: the user's device is no longer subscribed). The job leaves the task alone until this time instead of retrying every run, and never marks it as covered. A time in the past has no effect."
    },
    "reminder_plan_built_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the SERVER wrote this task's reminder_schedule (the Google Calendar import, or cronRefillReminders for a task dated more than ~30 days out). Once set, cronRefillReminders never builds a plan for this task again, so a plan the user clears in the app stays cleared."
    },
    "onesignal_notification_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of OneSignal scheduled notification IDs for batch cancellation"
    },
    "notification_recipient_email": {
      "type": "string",
      "description": "Email of the user who should receive notifications for this task"
    },
    "reminder_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "description": "OneSignal scheduled notification ID"
          },
          "send_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this reminder fires"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label like '1 day before', 'morning of', '1 hour before'"
          },
          "kind": {
            "type": "string",
            "description": "Machine-readable reminder kind (week_before, day_before, day_of, own_day_of, night_before, hour_before, \u2026). MUST stay in the schema: the refill cron branches on it, and when it wasn't persisted the cron treated every saved entry as mis-planned and re-booked + cancelled it on every run."
          },
          "scheduled": {
            "type": "boolean",
            "description": "True once this entry has a live OneSignal booking. Planned-only entries (too far out for OneSignal) are false and carry a 'planned_\u2026' notification_id until the refill cron promotes them."
          },
          "notification_title": {
            "type": "string",
            "description": "LLM-generated notification title"
          },
          "notification_body": {
            "type": "string",
            "description": "LLM-generated notification body"
          },
          "their_time": {
            "type": "boolean",
            "description": "True for a reminder the person added themselves at a time they picked (the reminder editor's Add). Like the task's own time it may go off, alarm and all, inside their quiet hours (RULES.md \u00a79 Q4)."
          }
        }
      },
      "description": "Structured LLM-decided reminder schedule for one-time/event tasks. Each entry can be individually cancelled or edited."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "snoozed",
        "cancelled"
      ],
      "default": "active",
      "description": "cancelled: an event that isn't happening (the task page's \"Cancelled\" link, events only). Its reminders and alarms are taken down like a completion's, but it never counts as done. It drops out of every active list; a Google Calendar copy of it stays cancelled on the next sync because the task row is kept."
    },
    "alert_style": {
      "type": "string",
      "enum": [
        "notification",
        "alarm"
      ],
      "description": "HOW this task's reminders arrive on the installed Android app, never WHEN. 'alarm' = every reminder this task already has (reminder_schedule entries, next_reminder) also rings as a real full-screen alarm on the phone; 'notification' = the usual push only. Unset = follow the user's default (User.alarm_mode). Set from the switch on the task's detail card. The alarm itself is native (android/, which you must not edit) and reads the task's existing reminder times; do not add reminder logic for it."
    },
    "silenced": {
      "type": "boolean",
      "default": false,
      "description": "Back Burner: when true, all notifications for this task are cancelled and suppressed until the user reactivates it. The task stays visible in the full task list but drops out of Today's Tasks and smart nudges."
    },
    "was_back_burnered": {
      "type": "boolean",
      "default": false,
      "description": "Set the first time the task is put on the back burner and never cleared, so a task that was parked, brought back and then finished still counts as a rescue on the Progress page (silenced alone only shows whether it is parked right now)."
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "pre_backburner_urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "description": "The urgency this task had before it was moved to the Back Burner. Back-burnered tasks are forced to 'low' (they're explicitly not a priority right now); this remembers the real priority so it can be restored when the task comes back off the Back Burner."
    },
    "energy_required": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "takes_time": {
      "type": "boolean",
      "description": "Whether doing this is a stretch of hands-on work worth timing (dishes, laundry, cleaning, cooking, studying) rather than a moment or a wait (a text, a call, a bill, a pill, an appointment). Set by the task parser at creation; the task card shows a Time it button only when true. Unset on older tasks \u2014 no button."
    },
    "life_area": {
      "type": "string",
      "enum": [
        "work",
        "personal"
      ],
      "description": "Whether this task belongs to the user's WORK life or their PERSONAL life. Set by the task parser at creation using the user's about_me context (a nurse's 'chart notes' is work; 'buy dog food' is personal), and freely overridable by the user from the card. Work tasks show a \ud83d\udcbc in front of the title. Unset on older tasks \u2014 treated as personal (no briefcase)."
    },
    "tag": {
      "type": "string",
      "description": "One free-text tag the user typed on the task card (\"mom\", \"work\", \"errand\" \u2014 anything, up to 24 characters). Shown as a coloured pill next to the priority; the same words always get the same colour on every card. Never set by the parser or a cron; the user's own, and empty until they add one."
    },
    "parent_task_id": {
      "type": "string",
      "description": "The ID of the parent task, if this is a sub-task"
    },
    "subtask_order": {
      "type": "number",
      "description": "Sequence position of this subtask within its parent task (1 = first step). Preserves the logical/chronological order the steps should be performed in."
    },
    "snooze_count": {
      "type": "number",
      "default": 0
    },
    "consecutive_snoozes": {
      "type": "number",
      "default": 0,
      "description": "Track consecutive snoozes for adaptive reminders"
    },
    "dismissed_count": {
      "type": "number",
      "default": 0,
      "description": "How many times a reminder for this task (a push or a full-screen alarm) was closed, swiped away, or opened without picking a snooze. Data only: it never changes, cancels or moves the task's reminders."
    },
    "ignored_count": {
      "type": "number",
      "default": 0,
      "description": "How many times a full-screen alarm for this task rang out with no response at all. Data only: nothing is rescheduled because of it \u2014 the task's remaining reminders carry on as booked."
    },
    "closed_count": {
      "type": "number",
      "default": 0,
      "description": "How many times a full-screen alarm for this task was closed with Home or Back while it rang, none of its buttons used (build 40 on). The ring stops and Smart Reminders decides when the task comes up again; no break. Data only."
    },
    "later_count": {
      "type": "number",
      "default": 0,
      "description": "How many times a full-screen alarm for this task was stopped with \"Later\" (put off without picking a snooze time; the task stays active, so smart nudges bring it back once its time has passed)."
    },
    "alarm_order": {
      "type": "object",
      "description": "Where this task's alarm rings among others at a time they set in the same minute, by clock time in the owner's time zone: { \"HH:MM\": { rank, with, why } }. rank 0 rings on the minute; each place after that rings 10 seconds later, so the phone rings it the moment the one before is answered. with: the ids of the tasks in that minute, sorted and joined by |. Set by the model (shared/alarmOrder.ts) when a task with a time they set is made or changed (Anna, Oct 21 2026: a 10 AM call should ring before a 10 AM watch setting)."
    },
    "put_off_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The days (YYYY-MM-DD, the owner's own date) on which a reminder or alarm for this task was put off: Later, a snooze, stopped without a snooze (the alarm's Open button, a swipe), closed, or rang out unanswered. Done doesn't count. Put off on 3 different days without being done, it moves to an eased plan (ease_plan). Cleared when they edit the task (its wording, priority or date). shared/easeOff.ts (Anna, Oct 22 2026)."
    },
    "ease_plan": {
      "type": "object",
      "description": "How Smart Reminders handles a task put off on 3 different days (shared/easeOff.ts, Anna, Oct 22 2026): { plan, level, why, since, at }. plan, judged by the model from what they typed, its priority and who relies on it: 'daily_alarm' (it matters: in the morning summary plus one alarm a day with only Done and Later), 'alarm_then_notice' (an ordinary task: the same, until that alarm is put off on 2 more days, then level 2 = one regular notification a day), 'digest' (low stakes: only the morning summary). since: the day it was eased. Cleared when they edit the task."
    },
    "notes_worthy": {
      "type": "boolean",
      "description": "For an event with no date or time yet (so no reminders): whether recording it and getting notes would help, judged once when it's made (onTaskUpdate asks generateReminderSchedule notesCheck, the same yes/no its reminders would ask). Its Record notes button shows from this until it has a time; once it has a date and time, its reminders' labels decide. Empty = not judged (Anna, Oct 20 2026)."
    },
    "later_until": {
      "type": "string",
      "format": "date-time",
      "description": "A break the person asked for by saying \"not now\" to this task (Later on its alarm or reminder, or a snooze they picked): nothing about the task (smart nudges, planned reminders, rhythm pings, phone alarms) until this time, except the time they set for it today. How long depends on its priority and how many \"not now\"s it had today (not_now_count; cancelTaskNotifications notNowUntil, Anna's table, Oct 20 2026). Read by the nudge planner, the reminder refill and the alarm sync."
    },
    "not_now_day": {
      "type": "string",
      "description": "The day (YYYY-MM-DD, in the owner's time zone) that not_now_count counts. A different day means none yet today."
    },
    "not_now_count": {
      "type": "number",
      "default": 0,
      "description": "How many times on not_now_day the person said \"not now\" to this task: each Later, and each run of snoozes (snoozed again when it rang back counts once). Sets the length of the next break (later_until): the 3rd for a low or medium task, the 4th for a high or urgent one, ends it for the day."
    },
    "quiet_hours_exempt": {
      "type": "boolean",
      "default": false,
      "description": "This task's repeating reminders keep going through the owner's quiet hours, and each one rings as an alarm on a phone set to full-screen reminders, until it is done. Set only when the user asked to be reminded until they finish (reminder_wish) AND said yes when the app asked whether that may run through the night. Never set by the parser or a cron."
    },
    "prep_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recorded notes: questions the user wrote down to ask at this event (the Notes page). They show on screen while it's recorded, and the notes say which ones got answered."
    },
    "original_interval": {
      "type": "string",
      "description": "Original reminder interval before adaptation"
    },
    "focus_mode_original_interval": {
      "type": "string",
      "description": "The reminder_interval this task had before entering Focus Mode. Restored when the user exits Focus Mode."
    },
    "focus_mode_original_next_reminder": {
      "type": "string",
      "format": "date-time",
      "description": "The next_reminder a recurring task had before entering Focus Mode. Restored on exit if it is still in the future. Only set for recurring-interval tasks; smart-reminder and one-time tasks are never rewritten by Focus Mode."
    },
    "focus_mode_notification_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OneSignal ids of the hourly Focus Mode check-ins booked for this task. Kept separate from onesignal_notification_ids so exiting Focus Mode cancels only the check-ins and never a task's own reminders."
    },
    "focus_mode_quiet_ask_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the morning question for this Focus Mode session goes out: at the end of the owner's quiet hours, 'pick up where you left off?' (Anna, Oct 13 2026: quiet hours just start \u2014 nothing asks anyone to stay up \u2014 and in the morning the app asks whether to continue the focus session). Booked on enter; cleared on exit."
    },
    "focus_mode_checkins_until": {
      "type": "string",
      "format": "date-time",
      "description": "When the last booked Focus Mode check-in goes out. setFocusMode writes it on enter; cronRefillReminders books the next hour's check-ins when it is under two hours away, so a one-time or smart-reminder task in focus keeps getting its hourly check-in until it is done (Anna, Oct 13 2026). Cleared on exit."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When task was completed, in true UTC (readers turn it into the person's own time)"
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of image URLs attached to this task",
      "default": []
    },
    "notes": {
      "type": "string",
      "description": "Additional notes for this task"
    },
    "follow_up_title": {
      "type": "string",
      "description": "The next step this chore leads to (\"Move the laundry to the dryer\"), set by the parser only for chores with an obvious timed next step. Sent as a reminder follow_up_minutes after the task is marked done."
    },
    "follow_up_minutes": {
      "type": "number",
      "description": "Minutes after completion at which the follow-up reminder goes out."
    },
    "next_occurrence_id": {
      "type": "string",
      "description": "Id of the next copy of this repeating task that completing it made. Lets un-checking it take that copy back, and stops a second completion from making another copy."
    },
    "follow_up_notification_id": {
      "type": "string",
      "description": "OneSignal id of the follow-up push booked when this task was completed (written by logTaskCompletion). Kept apart from onesignal_notification_ids because completing a task cancels and clears those. onTaskUpdate cancels it when the task is un-completed or deleted."
    },
    "reminder_wish": {
      "type": "string",
      "description": "The user's own instruction about how, when or how often to remind them, in their words (\"keep reminding me until I finish\", \"just once\", \"the night before and the morning of\"). Set by the parser only when they said one. The smart-nudge planner and the reminder-plan generator obey it over their defaults; it never changes WHAT the task is."
    },
    "anchor_time": {
      "type": "string",
      "description": "The clock time the user named for this task, local HH:MM. Each new occurrence of a recurring task starts here (a daily 'pills at 10' task made at 11:30 must still ring at 10:00 tomorrow, not 11:30)."
    },
    "time_stated": {
      "type": "boolean",
      "default": false,
      "description": "True when the person set this task's clock time themselves: they said or typed a clock time ('5 AM', 'at 3', 'in 20 minutes'), picked one in the app, or it's the start of an event on their own calendar. False for a time the app chose from words like 'tonight' or 'before bed'. Only a time they set may go off, alarm and all, inside their quiet hours (RULES.md \u00a79 Q4, Anna Oct 12 2026: 'if I had a flight at 5 a.m., id want that alarm'); see isTimeTheySet in base44/shared/quietHours.ts."
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "every_other_day",
        "weekdays",
        "weekly",
        "every_other_week",
        "monthly",
        "yearly"
      ],
      "default": "none",
      "description": "How often this task should recur after completion. 'weekdays' = business days only (Mon\u2013Fri): the next occurrence skips Saturday and Sunday."
    },
    "recurrence_days": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "With recurrence_pattern 'weekly': the specific weekdays it repeats on, 0 = Sunday \u2026 6 = Saturday (\"every Wednesday and Thursday\" = [3, 4]). The next occurrence is the next listed day after the current one. Empty/unset = plain weekly on the same weekday."
    },
    "birthday_person": {
      "type": "string",
      "description": "Name of the person whose birthday this is (for yearly birthday reminders)"
    },
    "is_own_birthday": {
      "type": "boolean",
      "default": false,
      "description": "True when this birthday is the USER'S OWN, not someone else's. Google Calendar almost always contains the account owner's birthday as a nameless yearly 'Happy birthday!' event, which would otherwise become a birthday with no name sitting in the text list asking the user to text themselves. When true the birthday is excluded from the scheduled-texts list and all 'write/send their text' prompts, and instead triggers a celebration popup for the user on the day."
    },
    "birthday_remind_week_before": {
      "type": "boolean",
      "default": false,
      "description": "Send a birthday reminder 1 week before. Only set on actual birthday tasks."
    },
    "birthday_remind_day_before": {
      "type": "boolean",
      "default": false,
      "description": "Send a birthday reminder 1 day before. Only set on actual birthday tasks."
    },
    "birthday_remind_day_of": {
      "type": "boolean",
      "default": false,
      "description": "Send a birthday reminder on the day of the birthday. Only set on actual birthday tasks."
    },
    "birthday_animal": {
      "type": "string",
      "description": "Set when the birthday is a pet's or another animal's: what kind, lowercase ('dog', 'cat', 'hamster'). Same reminders as anyone's birthday, but nothing about a text: no drafted message, no send-a-text nudges, not in the scheduled texts list. The day-of reminder says to celebrate them (Anna, Oct 12 2026). Empty = a person."
    },
    "birthday_text_message": {
      "type": "string",
      "description": "AI-drafted birthday text message the user can send via their messaging app on the day of the birthday"
    },
    "birthday_phone_number": {
      "type": "string",
      "description": "Optional phone number for the birthday person. When set, the Send Text button pre-fills both the recipient and the message body."
    },
    "birthday_text_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has pressed 'Send' for the birthday text. When true, hourly day-of reminders stop. Reset to false on yearly rollover."
    },
    "birthday_text_last_reminded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last hourly birthday text reminder sent by the cron. Used for deduplication to avoid spamming if the cron runs more than once per hour."
    },
    "classification": {
      "type": "string",
      "enum": [
        "task",
        "event",
        "birthday",
        "payment"
      ],
      "description": "Calendar/type classification. 'payment' = a bill or financial obligation (pay rent, pay credit card, transfer money) \u2014 behaves like a task everywhere but is visually tagged and filterable so users can review all their bills in one place. When set, overrides auto-detection in the calendar view."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}