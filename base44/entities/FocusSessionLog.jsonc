{
  "name": "FocusSessionLog",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "ID of the task focused on (when available)"
    },
    "task_title": {
      "type": "string",
      "description": "Title of the task that was focused on"
    },
    "duration_seconds": {
      "type": "number",
      "description": "How long the focus session lasted, in seconds"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the focus session began"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task was completed / session ended"
    },
    "user_email": {
      "type": "string",
      "description": "Owner's email for RLS \u2014 must be set so the record is visible to the user who earned it (allows backfill/automation logging that can't run in the user's own session)."
    }
  },
  "required": [
    "task_title",
    "duration_seconds",
    "completed_at",
    "user_email"
  ],
  "rls": {
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "write": {
      "data.user_email": "{{user.email}}"
    }
  }
}