{
  "name": "ScheduledText",
  "type": "object",
  "properties": {
    "recipient_name": {
      "type": "string",
      "description": "Who the text is for"
    },
    "phone_number": {
      "type": "string",
      "description": "Recipient phone number. When set, the Send button pre-fills the recipient in the messaging app.",
      "default": ""
    },
    "message": {
      "type": "string",
      "description": "The text message body to send"
    },
    "occasion": {
      "type": "string",
      "description": "Optional context/occasion for the text (e.g. 'follow up about the project', 'thank you for dinner', 'thinking of you')"
    },
    "send_at": {
      "type": "string",
      "format": "date-time",
      "description": "The original due time for the first reminder. For day-only texts this is 9 AM local on the chosen date; for time-specific texts it is the exact chosen date+time. Never changed by snoozing."
    },
    "send_time": {
      "type": "string",
      "description": "Optional time-of-day (HH:MM, 24h, local) for a time-specific text. When set, the first reminder fires at this exact time, then 10 min later, then hourly. When empty, the text is day-only (9 AM morning-of, then hourly)."
    },
    "sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has pressed Send (opens messaging app). Stops further reminders."
    },
    "last_reminded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last reminder push sent (pre-scheduled or cron). Used for hourly deduplication."
    },
    "snoozed_until": {
      "type": "string",
      "format": "date-time",
      "description": "When set to a future time, reminders (cron + in-app popup) are suppressed until this time passes. Set by the Snooze button."
    },
    "onesignal_notification_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "OneSignal scheduled notification IDs for the initial reminder(s): one for day-only (9 AM), two for time-specific (exact time + 10-min follow-up). Used for cancellation on edit/delete/send."
    },
    "notification_recipient_email": {
      "type": "string",
      "description": "Email of the user who should receive the reminder"
    }
  },
  "required": [
    "recipient_name",
    "message",
    "send_at"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}