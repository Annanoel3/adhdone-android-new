{
  "name": "DiaryEntry",
  "type": "object",
  "properties": {
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "The local calendar day this entry belongs to (YYYY-MM-DD). One entry per day per user."
    },
    "content": {
      "type": "string",
      "description": "The diary body, exactly as the user wrote it. Never read by AI, never shared with accountability partners \u2014 this is a sealed, user-only field."
    },
    "mood_answer": {
      "type": "string",
      "description": "Legacy field from when a separate 'how did your day go' prompt preceded the entry. No longer written \u2014 the diary page itself is the prompt now. Kept so old entries keep their first line."
    },
    "autofilled_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Titles of the tasks the user completed on this day, captured at the moment the entry was started (autofill option only). Snapshotted rather than looked up later so the entry stays a true record of that day."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "PRIVATE file URIs of pictures the user attached to this entry. Stored in private storage (never public URLs) so a diary photo can't be viewed by anyone holding a link \u2014 the app resolves a short-lived signed URL each time it displays one."
    },
    "stickers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "char": {
            "type": "string",
            "description": "The sticker character."
          },
          "x": {
            "type": "number",
            "description": "Horizontal position as a PERCENTAGE (0-100) of the page width, so a sticker lands in the same spot on any screen size."
          },
          "y": {
            "type": "number",
            "description": "Vertical position as a PERCENTAGE (0-100) of the page height."
          }
        }
      },
      "default": [],
      "description": "Stickers the user placed on the page, each with its own dragged position. Older entries stored plain characters with no position; the app treats those as unplaced and lays them out along the top."
    }
  },
  "required": [
    "entry_date"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}