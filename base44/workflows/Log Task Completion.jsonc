{
  "name": "Log Task Completion",
  "description": "Writes one analytics row each time a task is completed, including how many reminders went out first.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Task",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "log_task_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "log_completion": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logTaskCompletion",
            "args": {
              "task_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Log completion",
            "description": "With reminder history"
          }
        }
      }
    ]
  }
}