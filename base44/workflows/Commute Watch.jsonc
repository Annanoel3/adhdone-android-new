{
  "name": "Commute Watch",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "commute_watch",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_commutes": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cronCommuteWatch",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check commutes",
            "description": "Leave-now + traffic heads-up"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 15 minutes: for anyone with a work address and a shift today, measures the drive with live traffic and sends the 'time to leave' push, plus a heads-up when traffic is worse than usual."
}