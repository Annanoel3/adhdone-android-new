{
  "name": "Smart Task Nudge",
  "description": "Every 10 minutes: sends the Smart Reminders nudge that is due (so it lands within minutes of the moment the AI picked) and has the AI pick the next one after each nudge goes out, when it asked to look again, or when anything changed. One nudge at a time, never a day booked ahead (cronSmartTaskNudge, RULES.md \u00a710).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-20T13:39:19.743000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smart_task_nudge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cronSmartTaskNudge",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "cronSmartTaskNudge"
  }
}