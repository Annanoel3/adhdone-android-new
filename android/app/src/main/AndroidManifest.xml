<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Long-press menu on the app icon: "Add a task/idea" and "Quiet for 1 hour" -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!--
              Shared images used to land here (the WebView uploaded them), which meant a
              shared screenshot opened the app. They now go to CaptureActivity with shared
              text: read into a small JPEG on the spot, queued, and turned into a task by
              the sync worker — the app never opens for any share.
            -->

        </activity>

        <!-- Invisible share-sheet target: queues text or an image and finishes without opening the app -->
        <activity
            android:name=".CaptureActivity"
            android:theme="@style/AppTheme.Invisible"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:exported="true">

            <!-- Share sheet target: plain text, or a single image (no SEND_MULTIPLE) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <!-- The Today widget's "+": a small "type a task" box that never opens the app -->
        <activity
            android:name=".WidgetCaptureActivity"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:label="@string/app_name"
            android:exported="false" />

        <!-- Long-press menu's "Quiet for 1 hour": silences ADHDone for an hour and closes (QuietShortcutActivity) -->
        <activity
            android:name=".QuietShortcutActivity"
            android:theme="@style/AppTheme.Invisible"
            android:taskAffinity=""
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:label="@string/shortcut_quiet_long"
            android:exported="false" />

        <!-- Quick Settings tile "Add a task/idea": opens the typing box (AddTaskTileService) -->
        <service
            android:name=".AddTaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_adhdone"
            android:label="@string/tile_add_task"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- "Snooze 10 min" on a task's reminder, and the snoozed reminder coming back (TaskActions) -->
        <receiver
            android:name=".TaskActionReceiver"
            android:exported="false" />

        <!-- Inline reply on the pinned quick-capture notification -->
        <receiver
            android:name=".QuickCaptureReceiver"
            android:exported="false" />

        <!-- "Silence ADHDone for 1, 2 or 3 hours" buttons and the end-of-silence redraw -->
        <receiver
            android:name=".ReminderPauseReceiver"
            android:exported="false" />

        <!-- Home-screen "Today" widget -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Restores the pinned quick-capture notification after reboot / app update -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Real alarms for high/urgent tasks (AlarmBridge). AlarmManager fires into the
             receiver, which starts the foreground service that rings; the activity is the
             full-screen takeover. The receiver also re-books alarms when the user grants
             the "Alarms & reminders" special access. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Note-taking recorder (RecorderBridge): keeps the microphone recording with the
             screen off or the app in the background until the person taps Stop, showing a
             "Recording for notes" notification the whole time, as Android requires. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7979856440890193~9036825914"/>

        <!-- Runs for every incoming push, app open or not. Drops a reminder push when an
             alarm on this phone already covers that task at that time (see PushFilter). -->
        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="co.median.android.odxqpdy.PushFilter" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Alarms for high/urgent tasks. SCHEDULE_EXACT_ALARM is a special access the user
         switches on ("Alarms & reminders"); without it alarms still fire, just inexactly.
         USE_FULL_SCREEN_INTENT is what lets the alarm screen take over a locked phone; on
         Android 14+ the user has to grant it too. The foreground-service pair is for the
         ringing service. Battery-optimisation exemption keeps One UI from killing alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+: exact alarms granted at install, no toggle for the user to find.
         Android 14 gives a fresh install no SCHEDULE_EXACT_ALARM, so most new users'
         alarms were booked inexactly, up to ~10 minutes late (Anna, Oct 29 2026:
         "Why can't the phone book an exact alarm... that's not ok"). Google Play
         limits this to alarm and calendar apps and asks for a declaration in Play
         Console (App content > Exact alarm permission): ADHDone rings full-screen
         alarms for reminders and shows calendar event notifications. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The note-taking recorder's foreground service (RecorderService). RECORD_AUDIO above
         is still asked for at runtime, the first time someone taps Record. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "Display over other apps": lets a full-screen alarm open while the phone is in use
         (Android otherwise shows only a banner). Asked for in the app, never silently. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Phone calendars (CalendarBridge): read-only, asked for at runtime when the user chooses calendars to sync. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- "Notice when I wake up" (WakeWatch): only reads when the phone was first
         unlocked each morning. The person switches it on in Android's Usage access
         screen; nothing is read without that. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Hardware features are optional. Without these, CAMERA and RECORD_AUDIO imply
         android.hardware.camera / .microphone as REQUIRED, which makes Play filter the app
         off devices lacking them (Chromebooks, camera-less tablets) and triggers the
         PermissionImpliesUnsupportedChromeOsHardware lint. The app degrades gracefully
         without them, so they are declared not required. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

</manifest>
