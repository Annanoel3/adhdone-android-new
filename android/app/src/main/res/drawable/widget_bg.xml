<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget surface: the app's own page background.

  src/Layout.jsx:351 renders the app on "bg-gradient-to-br from-purple-50 via-
  orange-50 to-teal-50". Tailwind's "to-br" runs top-left -> bottom-right, which
  in Android's angle convention (0 = left-to-right, counter-clockwise) is 315.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/widget_grad_start"
        android:centerColor="@color/widget_grad_center"
        android:endColor="@color/widget_grad_end" />
    <corners android:radius="24dp" />
</shape>
