<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm screen from build 49 on (Anna, Nov 16 2026: "I like the big done,
     but also the later is maybe too small", then, of the picture she was sent,
     "Your design is good too"). One big round Done to tap; a wide Later bar
     that has to be HELD, with the task's name on it (HoldLaterView); the
     reminder's title large with its words under it. Snooze stays, as a small
     row. The third button only shows when the task has something to do in the
     app (a text to send, notes to record). The earlier screen is still
     activity_alarm.xml: AlarmActivity falls back to it if this one fails, and
     the server can switch this one off (AlarmLook).

     The ids the earlier screen has are kept, so AlarmActivity's shared code
     finds the same views in both. alarm_later is only a hidden stand-in here:
     the bar people hold is alarm_later_hold.

     Everything sits in a ScrollView that fills the screen. Nothing scrolls on a
     normal phone; with a very large system font the buttons can still be
     reached instead of being pushed off the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background">

    <ImageView
        android:id="@+id/alarm_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/alarm_bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- Two soft glows, drawn in code, on a plain dark background only. -->
    <View
        android:id="@+id/alarm_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/alarm_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <TextClock
                android:id="@+id/alarm_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:format12Hour="h:mm a"
                android:format24Hour="H:mm"
                android:textColor="@color/alarm_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- The words take whatever room the buttons leave. -->
            <LinearLayout
                android:id="@+id/alarm_words_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/alarm_words"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alarm_kicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.16"
                        android:text="@string/alarm_notification_heading"
                        android:textAllCaps="true"
                        android:textColor="@color/alarm_text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alarm_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="4"
                        android:textColor="@color/alarm_text"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alarm_task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.92"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:maxLines="6"
                        android:textColor="@color/alarm_text"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- The round button (Done; "Got it" or "Stop" where there is no
                 Done). Sized in code from the screen's height. Two tasks
                 ringing together get one round Done each in this row. -->
            <LinearLayout
                android:id="@+id/alarm_done_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/alarm_done"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:text="@string/alarm_action_done"
                    android:textAllCaps="false"
                    android:textColor="@color/alarm_text_on_dismiss"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/alarm_snooze_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/alarm_snooze_label"
                android:textColor="@color/alarm_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/alarm_snooze_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/alarm_snooze_10"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/alarm_snooze_10"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/alarm_snooze_30"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/alarm_snooze_30"
                    android:textAllCaps="false"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/alarm_snooze_60"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/alarm_snooze_60"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- The third button: only when the task has something to do in
                 the app (AlarmActivity.arrangeV2). -->
            <Button
                android:id="@+id/alarm_dismiss"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/alarm_dismiss"
                android:text="@string/alarm_action_dismiss"
                android:textAllCaps="false"
                android:textColor="@color/alarm_text_on_dismiss"
                android:textSize="17sp"
                android:textStyle="bold" />

            <co.median.android.odxqpdy.HoldLaterView
                android:id="@+id/alarm_later_hold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/alarm_later"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/alarm_later_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.82"
                android:gravity="center"
                android:text="@string/alarm_later_hint"
                android:textColor="@color/alarm_text"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
