<?xml version="1.0" encoding="utf-8"?>
<!--
  ADHDone "Today" home-screen widget.

  Fixed rows rather than a ListView/RemoteViewsService: a collection widget needs
  a bound Service and cannot address repeated <include> child ids, so five
  explicit rows keep this simple and reliable across launchers. Overflow beyond
  five is summarised by widget_more.

  Styled to the app's light pastel look (gradient page, white task chips, pastel
  urgency pills). There is no values-night palette on purpose — the app itself
  stays light when the phone is in dark mode, so the widget does too.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_header_text" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_accent" />

        <!-- Silence ADHDone for an hour (ReminderPause); "Sound on" while silenced. -->
        <TextView
            android:id="@+id/widget_silence"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"
            android:background="@drawable/widget_add_bg"
            android:contentDescription="Silence ADHDone for 1 hour" />

        <!-- Quick-add. A TextView rather than an ImageButton so the glyph scales with
             the rest of the header and needs no bitmap; RemoteViews supports both, but
             this keeps the widget free of raster assets. -->
        <TextView
            android:id="@+id/widget_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"
            android:background="@drawable/widget_add_bg"
            android:contentDescription="@string/widget_add" />
    </LinearLayout>

    <!-- Optional summary line from the web app, shown above the rows. Hidden unless
         updateTasks supplied a non-empty heading. -->
    <TextView
        android:id="@+id/widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone" />

    <!-- Task row 0 -->
    <LinearLayout
        android:id="@+id/widget_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_row_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_row_0_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_row_0_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_medium"
            android:textColor="@color/widget_pill_medium_text" />
    </LinearLayout>

    <!-- Task row 1 -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_row_1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_row_1_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_medium"
            android:textColor="@color/widget_pill_medium_text" />
    </LinearLayout>

    <!-- Task row 2 -->
    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_row_2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_row_2_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_medium"
            android:textColor="@color/widget_pill_medium_text" />
    </LinearLayout>

    <!-- Task row 3 -->
    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_row_3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_row_3_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_medium"
            android:textColor="@color/widget_pill_medium_text" />
    </LinearLayout>

    <!-- Task row 4 -->
    <LinearLayout
        android:id="@+id/widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_row_4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:id="@+id/widget_row_4_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_row_4_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_medium"
            android:textColor="@color/widget_pill_medium_text" />
    </LinearLayout>

    <!-- Overflow indicator -->
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingStart="4dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:visibility="gone" />

    <!-- Empty / stale state -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="4dp"
        android:textSize="13sp"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone" />
</LinearLayout>
