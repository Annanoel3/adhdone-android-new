<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_background">

    <!-- Seasonal artwork from the app's own theme, shown only once downloaded
         (AlarmTheme); the scrim above it keeps the text readable. -->
    <ImageView
        android:id="@+id/alarm_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/alarm_bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alarm_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/alarm_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/alarm_notification_heading"
            android:textColor="@color/alarm_text_muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/alarm_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/alarm_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarm_snooze_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/alarm_snooze_label"
            android:textColor="@color/alarm_text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/alarm_snooze_10"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/alarm_snooze_10" />

            <Button
                android:id="@+id/alarm_snooze_30"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/alarm_snooze_30" />

            <Button
                android:id="@+id/alarm_snooze_60"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/alarm_snooze_60" />
        </LinearLayout>

        <Button
            android:id="@+id/alarm_done"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/alarm_dismiss"
            android:text="@string/alarm_action_done"
            android:textColor="@color/alarm_text_on_dismiss"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Open task and Later share a row; with no task (or a timer's end)
             Later is hidden and Open task takes the whole row. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/alarm_dismiss"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:backgroundTint="@color/alarm_dismiss"
                android:text="@string/alarm_action_dismiss"
                android:textColor="@color/alarm_text_on_dismiss"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/alarm_later"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/alarm_dismiss"
                android:text="@string/alarm_action_later"
                android:textColor="@color/alarm_text_on_dismiss"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
