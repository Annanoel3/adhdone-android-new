<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose: the system's own widget update alarm is
  capped at 30 minutes and would waste wakeups. Refreshes are driven by the web
  app calling WidgetBridge.updateTasks(), and by WidgetRefreshWorker at local
  midnight so "Today" stays correct without the app being opened.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="300dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/widget_today"
    android:initialLayout="@layout/widget_today"
    android:updatePeriodMillis="0" />
