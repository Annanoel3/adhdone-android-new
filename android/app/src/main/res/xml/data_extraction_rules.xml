<?xml version="1.0" encoding="utf-8"?>
<!-- The base44 access token must never leave the device via backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="adhdone_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="adhdone_session.xml" />
    </device-transfer>
</data-extraction-rules>
