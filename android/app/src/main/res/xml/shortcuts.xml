<?xml version="1.0" encoding="utf-8"?>
<!-- The long-press menu on the ADHDone icon. Both open small screens that never open
     the app itself: the typing box (the same one as the widget's "+") and
     QuietShortcutActivity (ADHDone quiet for an hour, like the widget's "Silence 1 hr"). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_task"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="co.median.android.odxqpdy"
            android:targetClass="co.median.android.odxqpdy.WidgetCaptureActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="quiet_1h"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_quiet"
        android:shortcutShortLabel="@string/shortcut_quiet_short"
        android:shortcutLongLabel="@string/shortcut_quiet_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="co.median.android.odxqpdy"
            android:targetClass="co.median.android.odxqpdy.QuietShortcutActivity" />
    </shortcut>
</shortcuts>
