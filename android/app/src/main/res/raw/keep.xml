<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource-shrinker keep list (shrinkResources true).

  The splash screen is resolved at runtime by NAME: capacitor.config.ts sets
  androidSplashResourceName = "splash", and the SplashScreen plugin looks it up
  with getIdentifier(). R8's resource shrinker cannot see that reference, so
  without this the splash drawables would be stripped and the launch screen
  would break.

  The launcher foreground is a direct R.drawable reference (notification small
  icon) and is safe already, but is listed so an accidental refactor to a
  by-name lookup cannot silently remove it.

  The widget urgency pills are referenced only as R.drawable constants passed to
  RemoteViews.setInt(..., "setBackgroundResource", ...). R8 inlines those to bare
  integers, so the shrinker has nothing symbolic left to follow; only
  widget_pill_medium appears in the layout. Keeping all four explicitly.

  The alarm sound (res/raw/adhdone_alarm) is looked up by NAME in AlarmService so
  the build does not break while the file is missing; the shrinker cannot see
  that reference either, so it is kept here.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/adhdone_alarm,@drawable/widget_pill_*,@drawable/splash,@drawable/splash*,@drawable/ic_launcher_foreground,@mipmap/ic_launcher_foreground,@xml/config,@xml/file_paths,@xml/backup_rules,@xml/data_extraction_rules"
    tools:shrinkMode="safe" />
